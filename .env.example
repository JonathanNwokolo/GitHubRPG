# Copie para .env.local (nunca commite segredos). GITHUB_DATA_SOURCE e GITHUB_TOKEN são SERVER-ONLY:
# nenhuma das duas tem o prefixo NEXT_PUBLIC_ e nenhuma chega ao navegador.
# A única variável pública é NEXT_PUBLIC_SITE_URL (no fim do arquivo), que é só uma URL.

# Fonte de dados: "mock" (perfis de demonstração, determinísticos) ou "github" (API real, perfis públicos).
#   desenvolvimento / testes, sem a variável -> mock
#   produção, sem a variável                 -> ERRO (produção exige escolha explícita)
GITHUB_DATA_SOURCE=mock

# Token do GitHub (opcional). Só é lido quando GITHUB_DATA_SOURCE=github.
#   com token : REST + GraphQL (commits, PRs, issues, reviews, dias ativos, sequências), 5.000 req/h
#   sem token : só REST anônimo (perfil, repositórios, stars, linguagens), 60 req/h por IP;
#               as métricas de contribuição ficam "unavailable"
# Recomendado: fine-grained personal access token, SOMENTE leitura de repositórios públicos e
# nenhuma permissão extra. Veja GITHUB_API_INTEGRATION.md.
GITHUB_TOKEN=

# Integração de produto da Game Engine V2 (server-only). O default seguro é desligado.
# Quando a allowlist estiver vazia, todos os perfis ficam elegíveis após a flag principal ser ligada.
GAME_ENGINE_V2_UI_ENABLED=false
GAME_ENGINE_V2_UI_ALLOWLIST=

# URL pública do SITE (NÃO é segredo; pode ter o prefixo NEXT_PUBLIC_ porque é só uma URL).
# Usada em Open Graph, canonical e no link que "Compartilhar perfil" envia.
#   Vercel (Production): NEXT_PUBLIC_SITE_URL=https://githubrpg.vercel.app
#   sem a variável: produção usa https://githubrpg.vercel.app e desenvolvimento usa http://localhost:3000
# Atenção: o valor é embutido no build; ao mudá-la na Vercel, faça um novo deploy.
# Nunca coloque GITHUB_TOKEN (nem qualquer segredo) em uma variável NEXT_PUBLIC_.
NEXT_PUBLIC_SITE_URL=https://githubrpg.vercel.app
