            "content": "source 'https://rubygems.org'\n\ngem 'jekyll', '~> 4.4.1'\ngem 'jekyll-seo-tag', '~> 2.8.0'\ngem 'jekyll-sitemap', '~> 1.4.0'\ngem 'wdm', '~> 0.2.0', :install_if => Gem.win_platform?\n",
